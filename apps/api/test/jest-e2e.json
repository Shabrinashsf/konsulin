{
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "..",
    "testEnvironment": "node",
    "testRegex": "test/.*\\.e2e-spec\\.ts$",
    "transform": {
        "^.+\\.(t|j)s$": [
            "ts-jest",
            { "astTransformers": { "before": ["<rootDir>/test/swagger-plugin.js"] } }
        ]
    },
    "setupFiles": ["<rootDir>/test/setup-env.ts"]
}
